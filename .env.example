# Скопируй этот файл в .env и заполни:
#   cp .env.example .env
#
# Токен бота: Developer Portal -> твоё приложение -> Bot -> Reset Token
DISCORD_TOKEN=вставь_токен_сюда

# ID сервера: в Discord включи Настройки -> Расширенные -> Режим разработчика,
# затем ПКМ по иконке сервера -> Копировать ID сервера
GUILD_ID=123456789012345678
